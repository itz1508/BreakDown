{
  "title": "BreakDown Requirement Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_name",
    "overview",
    "technology_stack",
    "prerequisites",
    "core_features",
    "database_schema",
    "api_endpoints_summary",
    "open_questions",
    "implementation_steps",
    "success_criteria"
  ],
  "properties": {
    "project_name": { "type": "string", "minLength": 1 },
    "overview": { "type": "string", "minLength": 1 },
    "technology_stack": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version_floor", "purpose"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version_floor": { "type": "string" },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "items": { "type": "string" }
    },
    "core_features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "database_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity", "description"],
        "properties": {
          "entity": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "api_endpoints_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "path", "description"],
        "properties": {
          "method": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "implementation_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "title", "tasks"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "description",
                "target",
                "expected_outcome",
                "acceptance_criteria"
              ],
              "properties": {
                "description": { "type": "string", "minLength": 1 },
                "target": { "type": "string", "minLength": 1 },
                "expected_outcome": { "type": "string", "minLength": 1 },
                "acceptance_criteria": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/check" }
                }
              }
            }
          }
        }
      }
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "verification"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "verification": { "$ref": "#/$defs/check" }
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_kind", "check", "expected"],
      "properties": {
        "check_kind": {
          "type": "string",
          "enum": ["command", "observation"]
        },
        "check": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 }
      }
    }
  }
}
